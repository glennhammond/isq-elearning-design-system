{% extends "base.html.j2" %}
{% block content %}
<div class="docs-container">
  <p style="font-size:0.85rem;"><a href="{{ base }}components/index.html">← Components</a></p>

  <div class="docs-detail-header">
    <div>
      <span class="docs-eyebrow">{{ c.category|capitalize }} component</span>
      <h1 style="margin-bottom:6px;">{{ c.name }}</h1>
      <p class="docs-lede" style="font-size:1.02rem;">{{ c.purpose }}</p>
      <div class="docs-detail-header__meta">
        <span class="docs-status docs-status--{{ c.status }}">{{ c.status|replace('-', ' ') }}</span>
        <span class="docs-tag">Current implementation: ISQ Rise</span>
        <span>Version introduced: {{ c.versionIntroduced }}</span>
        <span>Platforms: {{ c.platforms|join(', ')|capitalize }}</span>
        <span>Owner: {{ c.owner }}</span>
      </div>
    </div>
  </div>

  {% if c.status in ['experimental', 'course-specific', 'legacy', 'deprecated'] %}
  <div class="docs-note docs-note--flag">
    <strong>{{ c.status|replace('-', ' ')|capitalize }}.</strong>
    {% if c.status == 'experimental' %}Being evaluated — specifications may change. Use only in an agreed pilot.
    {% elif c.status == 'course-specific' %}Built for a specialised need and not yet generalised. Do not reuse without review.
    {% elif c.status == 'legacy' %}Retained for existing courses only. Do not select for new work.
    {% elif c.status == 'deprecated' %}Scheduled for removal or replacement.
    {% endif %}
  </div>
  {% endif %}

  <div class="docs-module">
    <h2>ISQ Rise implementation preview</h2>
    <div class="docs-preview" data-docs-preview>
      <div class="docs-preview__bar">
        <span>Rendered with the governed ISQ production Rise CSS</span>
        <div class="docs-preview__toggle">
          <button type="button" data-docs-preview-mode="desktop" aria-pressed="true">Desktop</button>
          <button type="button" data-docs-preview-mode="mobile" aria-pressed="false">Mobile</button>
        </div>
      </div>
      <div class="docs-preview__frame">
        <link rel="stylesheet" href="{{ base }}assets/vendor/isq-rise-components-v1.0.0.css">
        {{ c.html|safe }}
      </div>
    </div>
    <p style="font-size:0.85rem; color:var(--docs-muted); margin-top:8px;">Light background shown; verify against a tinted or dark surface where the component is used that way in course.</p>
  </div>

  <div class="docs-module">
    <h2>Use when / avoid when</h2>
    <div class="docs-use-avoid">
      <div class="docs-use-avoid__col docs-use-avoid__col--use">
        <h3>Use when</h3>
        <ul>{% for u in c.useWhen %}<li>{{ u }}</li>{% endfor %}</ul>
      </div>
      <div class="docs-use-avoid__col docs-use-avoid__col--avoid">
        <h3>Avoid when</h3>
        <ul>{% for a in c.avoidWhen %}<li>{{ a }}</li>{% endfor %}</ul>
      </div>
    </div>
  </div>

  <div class="docs-module">
    <h2>Anatomy</h2>
    <ul>{% for a in c.anatomy %}<li>{{ a }}</li>{% endfor %}</ul>
  </div>

  {% if c.variants %}
  <div class="docs-module">
    <h2>Variants</h2>
    <div class="docs-related-list">{% for v in c.variants %}<code class="docs-tag">{{ v }}</code>{% endfor %}</div>
  </div>
  {% endif %}

  <div class="docs-module">
    <h2>States</h2>
    <div class="docs-related-list">{% for s in c.states %}<span class="docs-tag">{{ s }}</span>{% endfor %}</div>
  </div>

  <div class="docs-module">
    <h2>Responsive behaviour</h2>
    <p>{{ c.responsive }}</p>
  </div>

  <div class="docs-module">
    <h2>Accessibility</h2>
    <ul>{% for a in c.accessibility %}<li>{{ a }}</li>{% endfor %}</ul>
  </div>

  <div class="docs-module">
    <h2>Current implementation</h2>
    <p><strong>Theme and platform:</strong> ISQ · Articulate Rise</p>
    <p><strong>Implementation type:</strong> {{ c.implementation|join(', ') }}</p>
    <p>The classes below belong to the ISQ implementation namespace. A future theme may implement the same component contract with different tokens and class names.</p>
    {% if c.dependencies %}<p><strong>Dependencies:</strong> {{ c.dependencies|join('; ') }}</p>{% endif %}
  </div>

  <div class="docs-module">
    <h2>Code</h2>
    <div class="docs-code">
      <span class="docs-code__label">HTML</span>
      <button class="docs-copy-btn" type="button" data-docs-copy="code-{{ c.id }}">Copy</button>
      <pre><code id="code-{{ c.id }}">{{ c.html|e }}</code></pre>
    </div>
    <p style="font-size:0.85rem; color:var(--docs-muted); margin-top:8px;">Classes used: {% for cl in c.classes %}<code>.{{ cl }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</p>
    <p style="font-size:0.85rem;"><a href="{{ base }}implementations/isq/platforms/rise/index.html">ISQ production stylesheet reference →</a></p>
  </div>

  <div class="docs-module">
    <h2>Related items</h2>
    <p><strong>Related patterns:</strong>
    {% if c.relatedPatterns %}{% for p in c.relatedPatterns %}<a class="docs-tag" href="{{ base }}patterns/index.html#{{ p }}">{{ p|replace('-', ' ')|capitalize }}</a> {% endfor %}{% else %}—{% endif %}
    </p>
    <p><strong>Related components:</strong>
    {% if c.relatedComponents %}{% for rc in c.relatedComponents %}{% if rc in component_names %}<a class="docs-tag" href="{{ base }}components/{{ rc }}/index.html">{{ component_names.get(rc, rc) }}</a> {% else %}<span class="docs-tag">{{ rc }} (ISQ implementation primitive — see <a href="{{ base }}implementations/isq/foundations/index.html">ISQ foundations</a>)</span> {% endif %}{% endfor %}{% else %}—{% endif %}
    </p>
  </div>

  <div class="docs-module">
    <h2>Governance metadata</h2>
    <table class="docs-field-table">
      <tbody>
        <tr><th>Owner</th><td>{{ c.owner }}</td></tr>
        <tr><th>Status</th><td>{{ c.status|replace('-', ' ')|capitalize }}</td></tr>
        <tr><th>Version introduced</th><td>{{ c.versionIntroduced }}</td></tr>
        <tr><th>Last reviewed</th><td>{{ c.lastReviewed }}</td></tr>
        <tr><th>Known limitations</th><td>{% if c.knownLimitations %}<ul style="margin:0; padding-left:1.1em;">{% for k in c.knownLimitations %}<li>{{ k }}</li>{% endfor %}</ul>{% else %}None recorded.{% endif %}</td></tr>
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
