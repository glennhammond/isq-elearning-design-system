<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} — eLearning Design System</title>
<meta name="description" content="{{ description }}">
<link rel="stylesheet" href="{{ base }}assets/css/tokens.css">
<link rel="stylesheet" href="{{ base }}assets/css/base.css">
<link rel="stylesheet" href="{{ base }}assets/css/layout.css">
<link rel="stylesheet" href="{{ base }}assets/css/components.css">
<link rel="stylesheet" href="{{ base }}assets/css/documentation.css">
</head>
<body>
<a class="docs-skip-link" href="#docs-main">Skip to content</a>
<div class="docs-shell">
  <header class="docs-header">
    <div class="docs-header__inner">
      <a class="docs-logo" href="{{ base }}index.html">eLearning <span>Design System</span></a>
      <button class="docs-nav-toggle" aria-expanded="false" aria-controls="docs-primary-nav">Menu</button>
      <nav class="docs-primary-nav" id="docs-primary-nav" aria-label="Primary">
        <a class="docs-nav-link" href="{{ base }}overview/index.html" {% if section=='overview' %}aria-current="page"{% endif %}>Overview</a>
        <a class="docs-nav-link" href="{{ base }}foundations/index.html" {% if section=='foundations' %}aria-current="page"{% endif %}>Foundations</a>
        <a class="docs-nav-link" href="{{ base }}learning-design/index.html" {% if section=='learning-design' %}aria-current="page"{% endif %}>Learning design</a>
        <a class="docs-nav-link" href="{{ base }}patterns/index.html" {% if section=='patterns' %}aria-current="page"{% endif %}>Learning patterns</a>
        <a class="docs-nav-link" href="{{ base }}components/index.html" {% if section=='components' %}aria-current="page"{% endif %}>Components</a>
        <a class="docs-nav-link" href="{{ base }}implementations/index.html" {% if section=='implementations' %}aria-current="page"{% endif %}>Implementations</a>
        <a class="docs-nav-link" href="{{ base }}applications/index.html" {% if section=='applications' %}aria-current="page"{% endif %}>Applications</a>
        <a class="docs-nav-link" href="{{ base }}governance/index.html" {% if section=='governance' %}aria-current="page"{% endif %}>Governance</a>
      </nav>
      <div class="docs-search docs-search-wrap" role="search">
        <label class="docs-visually-hidden" for="docs-search-input">Search the design system</label>
        <input id="docs-search-input" type="search" placeholder="Search components, classes, patterns…" data-docs-search-input data-base="{{ base }}" autocomplete="off">
      </div>
      <div class="docs-search-results" data-docs-search-results hidden></div>
    </div>
  </header>

  <main class="docs-main" id="docs-main">
{% block content %}{% endblock %}
  </main>

  <footer class="docs-footer">
    <div class="docs-footer__inner">
      <div>
        <h2>System</h2>
        <ul>
          <li><a href="{{ base }}overview/index.html">Overview</a></li>
          <li><a href="{{ base }}governance/index.html">Governance</a></li>
          <li><a href="{{ base }}changelog/index.html">Changelog</a></li>
        </ul>
      </div>
      <div>
        <h2>Core system</h2>
        <ul>
          <li><a href="{{ base }}foundations/index.html">Foundations</a></li>
          <li><a href="{{ base }}learning-design/index.html">Learning design</a></li>
          <li><a href="{{ base }}patterns/index.html">Learning patterns</a></li>
          <li><a href="{{ base }}components/index.html">Components</a></li>
        </ul>
      </div>
      <div>
        <h2>Implementations</h2>
        <ul>
          <li><a href="{{ base }}implementations/index.html">Implementation directory</a></li>
          <li><a href="{{ base }}applications/index.html">Course applications</a></li>
        </ul>
      </div>
      <div>
        <h2>Resources</h2>
        <ul>
          <li><a href="{{ base }}resources/index.html">Templates &amp; resources</a></li>
          <li><a href="{{ base }}changelog/index.html">Changelog</a></li>
        </ul>
        <p>Accessibility requirements are documented at foundation, pattern and component level.</p>
      </div>
    </div>
  </footer>
</div>

<script src="{{ base }}assets/js/navigation.js"></script>
<script src="{{ base }}assets/js/search.js"></script>
<script src="{{ base }}assets/js/filters.js"></script>
<script src="{{ base }}assets/js/component-preview.js"></script>
</body>
</html>
