{% extends "base.html.j2" %}
{% block content %}
<section class="docs-hero">
  <div class="docs-hero__inner">
    <span class="docs-eyebrow">eLearning Design System</span>
    <h1>One design language, defined once, consumed everywhere.</h1>
    <p class="docs-lede docs-hero__statement">Learning intent · experience structure · components · implementations · governance</p>
    <p class="docs-lede">A reusable, implementation-independent system for designing coherent digital learning. It defines shared intent and quality requirements, then allows each organisation, product and platform to express them through its own governed implementation.</p>
    <div class="docs-hero__actions">
      <a class="docs-btn docs-btn--primary" href="{{ base }}components/index.html">Explore components</a>
      <a class="docs-btn docs-btn--secondary" href="{{ base }}patterns/index.html">Choose a learning pattern</a>
      <a class="docs-btn docs-btn--secondary" href="{{ base }}implementations/index.html">Explore implementations</a>
      <a class="docs-btn docs-btn--secondary" href="{{ base }}resources/index.html">Templates &amp; resources</a>
    </div>
  </div>
</section>

<section class="docs-quick-paths docs-container--standard" style="margin:0 auto;">
  <div class="docs-section-title"><h2>Core and implementation boundary</h2></div>
  <div class="docs-grid docs-grid--2">
    <div class="docs-card" style="cursor:default;">
      <span class="docs-eyebrow">Core system</span>
      <h3>Reusable learning and experience decisions</h3>
      <p>Learning purposes, structures, expressions, component contracts, accessibility and governance remain independent of any one organisation.</p>
    </div>
    <a class="docs-card" href="{{ base }}implementations/index.html">
      <span class="docs-eyebrow">Implementation layer</span>
      <h3>Governed organisational and platform expressions</h3>
      <p>Branding, production code, platform guidance and course evidence are contained within named implementations.</p>
    </a>
  </div>
</section>

<section class="docs-quick-paths docs-container--standard" style="margin:0 auto;">
  <div class="docs-section-title"><h2>Quick paths</h2></div>
  <div class="docs-grid docs-grid--3">
    {% for path in quick_paths %}
    <a class="docs-card" href="{{ base }}{{ path.url }}">
      <h3>{{ path.title }}</h3>
      <p>{{ path.body }}</p>
    </a>
    {% endfor %}
  </div>
</section>

<section class="docs-quick-paths docs-container--standard" style="margin:0 auto;">
  <div class="docs-section-title"><h2>System architecture</h2></div>
  <div class="docs-grid docs-grid--3">
    {% for layer in architecture %}
    <div class="docs-card" style="cursor:default;">
      <span class="docs-eyebrow">{{ layer.eyebrow }}</span>
      <h3>{{ layer.title }}</h3>
      <p>{{ layer.body }}</p>
    </div>
    {% endfor %}
  </div>
</section>

<section class="docs-quick-paths docs-container--standard" style="margin:0 auto;">
  <div class="docs-section-title"><h2>Current state</h2></div>
  <div class="docs-state-summary">
    <div class="docs-state-summary__item"><span class="docs-state-summary__number">{{ stats.version }}</span><span class="docs-state-summary__label">Current version</span></div>
    <div class="docs-state-summary__item"><span class="docs-state-summary__number">{{ stats.approved }}</span><span class="docs-state-summary__label">Core / approved components</span></div>
    <div class="docs-state-summary__item"><span class="docs-state-summary__number">{{ stats.experimental_course }}</span><span class="docs-state-summary__label">Experimental / course-specific</span></div>
    <div class="docs-state-summary__item"><span class="docs-state-summary__number">{{ stats.legacy }}</span><span class="docs-state-summary__label">Legacy</span></div>
  </div>
  <p style="margin-top: var(--docs-space-3); color: var(--docs-muted); font-size:0.9rem;">Last updated {{ stats.updated }} · Roadmap stage: {{ stats.roadmap_stage }}</p>
</section>

<section class="docs-quick-paths docs-container--standard" style="margin:0 auto;">
  <div class="docs-section-title"><h2>Featured references</h2></div>
  <div class="docs-grid docs-grid--4">
    {% for ref in featured %}
    <a class="docs-card" href="{{ base }}{{ ref.url }}">
      <h3>{{ ref.title }}</h3>
      <p>{{ ref.body }}</p>
    </a>
    {% endfor %}
  </div>
</section>
{% endblock %}
